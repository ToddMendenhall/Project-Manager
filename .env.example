# Postgres connection string (Neon, Supabase, or local Postgres all work)
DATABASE_URL=postgres://user:password@localhost:5432/project_manager

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Base URL of the app (used by Auth.js)
AUTH_URL=http://localhost:3000

# Set to "false" to stop anyone creating a new organization from /register
# (people then join only through admin invites). Defaults to open.
# ALLOW_REGISTRATION=false
